#!/bin/sh
# 双栈优先 IPv4：mosdns _prefer_ipv4
#   - 仅屏蔽"双栈域名"的 AAAA，纯 IPv6 域名照常解析（治 filter_aaaa 导致纯 v6 进不去的痛点）
#   - mosdns 监听 5335；dnsmasq 转发到它
#   - 国外上游走 DoH（1.1.1.1 / 8.8.8.8），绕开国内对纯 v6 / 被污染域名的 DNS 封锁
[ -x /usr/sbin/mosdns ] || exit 0

# ---- mosdns ----
uci -q set mosdns.config.enabled='1'
uci -q set mosdns.config.listen_port='5335'
uci -q set mosdns.config.prefer_ipv4='1'
# 国内上游（直连，速度快）
uci -q del mosdns.config.local_dns
uci -q add_list mosdns.config.local_dns='223.5.5.5'
uci -q add_list mosdns.config.local_dns='119.29.29.29'
# 国外上游走 DoH（IP 直连，免 bootstrap）
uci -q del mosdns.config.remote_dns
uci -q add_list mosdns.config.remote_dns='https://1.1.1.1/dns-query'
uci -q add_list mosdns.config.remote_dns='https://8.8.8.8/dns-query'
uci -q set mosdns.config.bootstrap_dns='119.29.29.29'
# geo 数据从 GitHub 拉，国内用代理提高成功率（不可用就换 ghproxy.net / mirror.ghproxy.com）
uci -q set mosdns.config.github_proxy='https://ghproxy.net'
uci -q set mosdns.config.geo_auto_update='1'
uci commit mosdns
/etc/init.d/mosdns enable 2>/dev/null

# ---- dnsmasq 转发到 mosdns ----
uci -q set dhcp.@dnsmasq[0].noresolv='1'
uci -q del dhcp.@dnsmasq[0].server
uci -q add_list dhcp.@dnsmasq[0].server='127.0.0.1#5335'
# 关掉 dnsmasq 自身外部缓存，改由 mosdns 单边缓存（避免双层缓存 + 规避 dnsmasq lazy-cache CPU 浪涌 bug）
uci -q set dhcp.@dnsmasq[0].cache_size='0'
uci commit dhcp

exit 0
