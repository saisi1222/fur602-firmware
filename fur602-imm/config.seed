# !! 仅作参考，工作流不会再用它：本文件缺少 CONFIG_MTK_* 无线 Kconfig，
#    直接用它会编出「没有无线驱动」的固件，正式编译请用 fur602-imm/config.full。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_honor_fur-602=y

# ---- 用户指定功能 ----
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci=y


CONFIG_PACKAGE_kmod-nft-offload=y

# ---- 无线：本源码自带闭源 MTK（package/mtk/drivers/mt_wifi）；
#      注意：kmod-mediatek_hnat 由源码 package/kernel/linux/modules/netdevices.mk 定义，
#      不在 MTK feed 里，feed 24.10/patches-base 也无 0014-package-kernel-add-mtkhnat ----
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_wifi-profile=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_wifi-scripts=y

# ---- 防缺包：上次失败于 opkg 装不上 libustream-openssl20201210 ----
CONFIG_PACKAGE_libustream-openssl20201210=y
CONFIG_PACKAGE_wpad-openssl=y

# ---- 明确排除 ----
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-turboacc-mtk is not set
# CONFIG_PACKAGE_kmod-macvlan is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
