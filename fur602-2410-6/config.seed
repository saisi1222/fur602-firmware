# === 25.12 硬件 NAT 卸载 (flow offload / PPE) + 全锥形 NAT ===
CONFIG_PACKAGE_kmod-nft-offload=y
# 全锥形 NAT：nftables fullcone 表达式（依赖 kmod-nft-nat，firewall4 已带 fullcone 补丁）
CONFIG_PACKAGE_kmod-nft-fullcone=y
