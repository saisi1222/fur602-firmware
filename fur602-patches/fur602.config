# FUR-602 编译配置 (base: padavanonly/immortalwrt-mt798x-6.6 @ openwrt-24.10-6.6)
# 用法: cp fur602.config padavanonly/.config && cd padavanonly && make defconfig
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_honor_fur-602=y

# ---- 全锥形 NAT (nft fullcone) ----
# 用户态补丁由 padavanonly 自带 (libnftnl/nftables/firewall4)
# 内核模块 nft_fullcone.ko 由 fullcone feed 提供
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ---- 闭源 mtwifi 驱动 (与现固件一致) ----
CONFIG_PACKAGE_kmod-mt_wifi=y

# ---- CPU 降频 (内核 ARM_MEDIATEK_CPUFREQ=y 已在 filogic config 默认开启) ----
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-cpufreq=y

# ---- 基础路由/AP 必备 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_kmod-nft-offload=y

# ---- nft_fullcone 内核依赖 (务必 =y，否则模块不工作或编译失败) ----
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_CHAIN_EVENTS=y
