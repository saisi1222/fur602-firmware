#!/bin/sh
# FUR-602 25.12：硬件 NAT 卸载 + 全锥形 NAT 默认开启
#
# 1) 硬件加速：flow offload + 硬件 offload (PPE/WED)
#    kmod-nft-offload 提供 nft offload 表达式；flow_offloading_hw=1 走 MT798x 的
#    PPE/WED 硬件转发，CPU 几乎不参与 NAT，配合 WED 还能卸载 WiFi 上行。
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'

# 2) 全锥形 NAT (FullCone)
#    firewall4 的 fullcone 补丁提供 defaults.fullcone / defaults.fullcone6 开关：
#    fullcone=1 对开启 masq 的区(wan)生效；fullcone6=0 关掉 IPv6（多数流量不需要）。
#    依赖 kmod-nft-fullcone（内核 nft_fullcone 模块，已在 config.seed 编入）。
uci -q set firewall.@defaults[0].fullcone='1'
uci -q set firewall.@defaults[0].fullcone6='0'

uci commit firewall
exit 0
