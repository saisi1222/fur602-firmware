#!/bin/sh
# 首次启动配置无线（驱动无关：mac80211（25.12 开源 mt7915e）与 mtwifi 均可）
# 双频默认开启、开放无密码（首次启动便于接入配置）、SSID 1111 / 1111-5G
# 2.4G HE40 @ auto，5G HE160 @ ch36

[ -s /etc/config/wireless ] || wifi config >/dev/null 2>&1

for d in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q set wireless.$d.country='CN'
	uci -q set wireless.$d.disabled='0'

	band=$(uci -q get wireless.$d.band)
	# 兼容无 band 属性的旧式配置：按 hwmode/频段字段推断
	[ -n "$band" ] || {
		hw=$(uci -q get wireless.$d.hwmode 2>/dev/null)
		case "$hw" in *11a*|*a*) band=5g ;; *) band=2g ;; esac
	}

	case "$band" in
		2g)
			uci -q set wireless.$d.channel='auto'
			uci -q set wireless.$d.htmode='HE40'
			;;
		5g)
			uci -q set wireless.$d.channel='36'
			uci -q set wireless.$d.htmode='HE160'
			;;
	esac

	# 找到挂在该设备下的 wifi-iface
	for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)\.device='$d'$/\1/p"); do
		uci -q set wireless.$s.disabled='0'
		uci -q set wireless.$s.network='lan'
		uci -q set wireless.$s.mode='ap'
		uci -q set wireless.$s.encryption='none'
		case "$band" in
			2g) uci -q set wireless.$s.ssid='1111' ;;
			5g) uci -q set wireless.$s.ssid='1111-5G' ;;
		esac
	done
done

uci commit wireless
exit 0
