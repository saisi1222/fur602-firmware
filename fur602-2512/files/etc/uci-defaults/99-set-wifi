#!/bin/sh
# 首启配无线：SSID 1111 / 1111_5G，开放无密码；2.4G HE40 auto，5G HE160 ch36（mac80211/mtwifi 通用）
[ -s /etc/config/wireless ] || wifi config >/dev/null 2>&1

for d in $(uci show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	band=$(uci -q get wireless.$d.band)
	uci -q set wireless.$d.disabled='0'
	uci -q set wireless.$d.country='CN'
	for s in $(uci show wireless | sed -n "s/^wireless\.\([^.=]*\)\.device='$d'$/\1/p"); do
		case "$band" in
			5g) uci -q set wireless.$s.ssid='1111_5G'
			    uci -q set wireless.$d.channel='36'
			    uci -q set wireless.$d.htmode='HE160' ;;
			*)  uci -q set wireless.$s.ssid='1111'
			    uci -q set wireless.$d.channel='auto'
			    uci -q set wireless.$d.htmode='HE40' ;;
		esac
		uci -q set wireless.$s.network='lan'
		uci -q set wireless.$s.mode='ap'
		uci -q set wireless.$s.encryption='none'
		uci -q set wireless.$s.disabled='0'
	done
done
uci commit wireless
exit 0
